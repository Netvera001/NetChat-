{
  "rules": {
    "presence": {
      ".read": "auth != null && auth.token.email_verified == true",
      "$uid": {
        ".write": "auth != null && auth.token.email_verified == true && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "typing": {
      "$conversationId": {
        ".read": "auth != null && auth.token.email_verified == true",
        "$uid": {
          ".write": "auth != null && auth.token.email_verified == true && auth.uid === $uid",
          ".validate": "newData.val() == null || (newData.hasChildren(['active', 'updatedAt']) && newData.child('active').isBoolean() && newData.child('updatedAt').isNumber())"
        }
      }
    }
  }
}
